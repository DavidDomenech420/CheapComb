{
  "expo": {
    "name": "CheapComb",
    "slug": "expo-template-blank",
    "scheme": "cheapComb",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.kei.cheapcomb",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#07376D",
        "foregroundImage": "./assets/logo.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-location",
      "expo-status-bar"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "32ce38b2-8c01-4c45-aff4-8c01ae68987b"
      }
    },
    "owner": "daviddom"
  }
}
